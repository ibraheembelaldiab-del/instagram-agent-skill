[
 {"name": "01", "who": "auntie_deep", "text": "哎呀妈呀！我的橘子啊！", "instruct": "用东北话说这句话"},
 {"name": "02", "who": "auntie_deep", "text": "这可咋整啊？谁来搭把手啊？", "instruct": "用东北话说这句话"},
 {"name": "03", "who": "jay", "text": "没看见……没看见……", "instruct": "用心虚的语气小声说"},
 {"name": "04", "who": "auntie_deep", "text": "你这孩子嘎哈呢？瞅见了也不帮一把？", "instruct": "用东北话说这句话"},
 {"name": "05", "who": "jay", "text": "哎哟……这么多人呢，凭啥是我啊？", "instruct": "用委屈的语气说"},
 {"name": "06", "who": "jay", "text": "脑子！你给我出来！", "instruct": "用生气的语气大声说"},
 {"name": "07", "who": "brain", "text": "来了来了！你刚才那句话，心理学有个名字，叫旁观者效应。", "instruct": "用得意的语气说"},
 {"name": "08", "who": "brain", "text": "1968年有个实验：大学生用对讲机聊天，突然有人发病求救。", "instruct": "用讲故事的语气说"},
 {"name": "09", "who": "brain", "text": "以为只有自己听见的人，百分之八十五都冲出去帮忙。", "instruct": "用讲故事的语气说"},
 {"name": "10", "who": "brain", "text": "以为还有四个人也听见了的，只有百分之三十一。", "instruct": "用惊讶的语气说"},
 {"name": "11", "who": "jay", "text": "所以……人越多，越没人管？", "instruct": "用恍然大悟的语气说"},
 {"name": "12", "who": "brain", "text": "对！每个人都觉得：反正有别人。责任就这么被分没了。", "instruct": "用得意的语气说"},
 {"name": "13", "who": "auntie_deep", "text": "那我咋整？总不能回回拿大葱抽人吧？", "instruct": "用东北话说这句话"},
 {"name": "14", "who": "brain", "text": "有办法！别冲所有人喊，指着一个人说。", "instruct": "用得意的语气说"},
 {"name": "15", "who": "brain", "text": "有个海滩实验：小偷偷收音机，没人拜托的时候，只有百分之二十的人出手。", "instruct": "用讲故事的语气说"},
 {"name": "16", "who": "brain", "text": "可要是主人提前拜托过某一个人帮忙看着，百分之九十五都会出手拦！", "instruct": "用惊讶的语气说"},
 {"name": "17", "who": "auntie_deep", "text": "那个戴橙色头盔的！对，就你！帮我捡橘子！", "instruct": "用东北话说这句话"},
 {"name": "18", "who": "del", "text": "好嘞阿姨！", "instruct": "用热情的语气说"},
 {"name": "19", "who": "catold", "text": "嘿嘿嘿……这条鱼，归老子了。", "instruct": "用贪心的语气偷偷说"},
 {"name": "20", "who": "auntie_deep", "text": "哎？我的鱼呢？", "instruct": "用东北话说这句话"},
 {"name": "21", "who": "catold", "text": "随……便。", "instruct": "用慵懒不屑的语气说"},
 {"name": "22", "who": "brain", "text": "下回需要帮忙，记住：指着一个人喊！转给那个总说会有别人管的朋友。", "instruct": "用得意的语气说"}
]
